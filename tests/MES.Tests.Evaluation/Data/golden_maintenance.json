{
  "agent": "MaintenanceAgent",
  "version": "1.0",
  "description": "Golden dataset for MaintenanceAgent evaluation — 故障预测与维保推荐",
  "testCases": [
    {
      "id": "MT-PRED-001",
      "scenario": "主轴轴承故障预测-振动异常",
      "input": {
        "equipmentId": "CNC-003",
        "telemetry": {
          "vibrationX": [0.8, 1.2, 2.1, 3.5, 4.2, 5.1, 6.3],
          "vibrationY": [0.5, 0.9, 1.8, 3.1, 3.9, 4.8, 5.9],
          "temperature": [65, 67, 72, 78, 85, 92, 101],
          "runtimeHours": 4800
        },
        "thresholds": { "vibrationMax": 4.0, "temperatureMax": 90 }
      },
      "expected": {
        "failurePredicted": true,
        "failureType": "bearing_degradation",
        "urgency": "high",
        "remainingUsefulLifeDays": { "max": 14 }
      },
      "dimensions": ["accuracy", "completeness"]
    },
    {
      "id": "MT-PRED-002",
      "scenario": "无异常-正常运行",
      "input": {
        "equipmentId": "CNC-004",
        "telemetry": {
          "vibrationX": [0.3, 0.4, 0.35, 0.5, 0.4, 0.45, 0.5],
          "vibrationY": [0.2, 0.3, 0.25, 0.35, 0.3, 0.28, 0.32],
          "temperature": [55, 56, 54, 57, 55, 56, 55],
          "runtimeHours": 1200
        },
        "thresholds": { "vibrationMax": 4.0, "temperatureMax": 90 }
      },
      "expected": {
        "failurePredicted": false,
        "nextMaintenanceDays": { "min": 45 }
      },
      "dimensions": ["accuracy"]
    },
    {
      "id": "MT-MAINT-001",
      "scenario": "预防性维保计划-周期到达",
      "input": {
        "equipmentId": "CNC-005",
        "telemetry": {
          "vibrationX": [0.6, 0.7, 0.8, 0.9, 1.0],
          "vibrationY": [0.4, 0.5, 0.6, 0.7, 0.8],
          "temperature": [60, 62, 65, 68, 70],
          "runtimeHours": 7200
        },
        "maintenancePlan": {
          "type": "preventive",
          "intervalHours": 7000,
          "lastDoneHours": 0
        }
      },
      "expected": {
        "maintenanceDue": true,
        "recommendedAction": "overhaul_inspection",
        "estimatedDowntimeHours": { "min": 4, "max": 8 },
        "partsNeeded": ["bearing_kit", "seal_set"]
      },
      "dimensions": ["accuracy", "completeness"]
    },
    {
      "id": "MT-RCMD-001",
      "scenario": "维保方案建议-成本优化",
      "input": {
        "equipmentId": "CNC-006",
        "failureType": "spindle_drift",
        "severity": "medium",
        "productionImpact": {
          "affectedOrders": ["WO-040", "WO-041"],
          "dailyLossValue": 15000
        },
        "options": [
          { "type": "quick_fix", "cost": 2000, "downtimeHours": 2, "recurrenceRisk": 0.6 },
          { "type": "full_replace", "cost": 12000, "downtimeHours": 8, "recurrenceRisk": 0.05 }
        ]
      },
      "expected": {
        "recommendedOption": "full_replace",
        "reasoningIncludes": "cost_analysis",
        "paybackPeriodDays": { "max": 30 }
      },
      "dimensions": ["accuracy", "completeness", "adoptability"]
    }
  ]
}
