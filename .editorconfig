# .editorconfig — AIMes V1
root = true

[*]
indent_style = space
indent_size = 4
charset = utf-8
trim_trailing_whitespace = true
insert_final_newline = true

[*.{cs,vb}]
dotnet_sort_system_directives_first = true
dotnet_style_require_accessibility_modifiers = always

# 命名规则
dotnet_naming_symbols.interfaces.required_modifiers = public
dotnet_naming_symbols.interfaces.applicable_kinds = interface
dotnet_naming_style.interface_prefix.required_prefix = I
dotnet_naming_rule.interface_names.symbols = interfaces
dotnet_naming_rule.interface_names.style = interface_prefix

[*.cs]
csharp_style_var_for_built_in_types = true
csharp_style_var_when_type_is_apparent = true
csharp_style_expression_bodied_methods = true
csharp_style_expression_bodied_properties = true
csharp_style_pattern_matching_over_is_with_cast_check = true
csharp_style_throw_expression = true
csharp_style_prefer_primary_constructors = false
csharp_using_directive_placement = outside_namespace:silent

[*.{js,ts,vue}]
indent_size = 2
indent_style = space

[*.{yml,yaml}]
indent_size = 2
indent_style = space

[*.json]
indent_size = 2

[*.md]
indent_size = 2
trim_trailing_whitespace = false
