+    return '排产反馈已写入本地复盘记录；正式排产计划已更新'
+  }
+  if (requiresFormalScheduleSave.value) {
+    return '排产反馈已写入本地复盘记录；正式计划待优化或保存'
+  }
+  return '排产反馈已写入本地复盘记录'
+})
+
