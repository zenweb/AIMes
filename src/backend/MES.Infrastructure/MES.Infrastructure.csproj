<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <DefineConstants Condition="'$(ExcludeAgentDecisionModels)' == 'true'">$(DefineConstants);EXCLUDE_AGENT_DECISION_MODELS</DefineConstants>
  </PropertyGroup>

  <ItemGroup Condition="'$(ExcludeAgentDecisionModels)' == 'true'">
    <Compile Remove="Data\Configurations\Agent*.cs" />
    <Compile Remove="Repositories\AgentDecisionRepository.cs" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\MES.Application\MES.Application.csproj" />
    <ProjectReference Include="..\MES.Domain\MES.Domain.csproj" />
  </ItemGroup>

  <!-- Database -->
  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" />
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <!-- Messaging -->
  <ItemGroup>
    <PackageReference Include="MassTransit" />
    <PackageReference Include="RabbitMQ.Client" />
  </ItemGroup>

  <!-- Export rendering -->
  <ItemGroup>
    <PackageReference Include="ClosedXML" />
    <PackageReference Include="QuestPDF" />
  </ItemGroup>

  <!-- MediatR -->
  <ItemGroup>
    <PackageReference Include="MediatR" />
  </ItemGroup>

  <!-- IoT Hub -->
  <ItemGroup>
    <PackageReference Include="Microsoft.Azure.Devices" />
    <PackageReference Include="Newtonsoft.Json" />
  </ItemGroup>

  <!-- Configuration -->
  <ItemGroup>
    <PackageReference Include="YamlDotNet" />
  </ItemGroup>

  <!-- Logging -->
  <ItemGroup>
    <PackageReference Include="Serilog" />
    <PackageReference Include="Serilog.Sinks.Console" />
  </ItemGroup>

</Project>
