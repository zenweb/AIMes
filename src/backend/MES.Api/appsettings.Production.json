{
  "Logging": {
    "LogLevel": {
      "Default": "Warning",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console"
      },
      {
        "Name": "File",
        "Args": {
          "path": "logs/aimes-.log",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 30,
          "shared": true
        }
      },
      {
        "Name": "OpenTelemetry",
        "Args": {
          "endpoint": "http://localhost:4317",
          "resourceAttributes": {
            "service.name": "AIMes.Api",
            "service.namespace": "AIMes",
            "deployment.environment": "Production"
          }
        }
      }
    ]
  },
  "OpenTelemetry": {
    "OTLP": {
      "Endpoint": ""
    }
  },
  "ConnectionStrings": {
    "DefaultConnection": ""
  },
  "AllowedOrigins": [],
  "AI": {
    "Llm": {
      "Provider": "AzureOpenAI"
    }
  },
  "Aimes": {
    "_comment": "生产环境硬性要求：以下两项必须全部为 false。docker-compose.yml 仅用于本地评估场景。",
    "EnableSwagger": false,
    "DisableHttpsRedirect": false
  }
}
