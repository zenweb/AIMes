{
  "Logging": {
    "LogLevel": {
      "Default": "Warning",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "ConnectionStrings": {
    "DefaultConnection": ""
  },
  "AllowedOrigins": [],
  "AI": {
    "Llm": {
      "Provider": "AzureOpenAI"
    }
  },
  "Aimes": {
    "_comment": "生产环境硬性要求：以下两项必须全部为 false。docker-compose.yml 仅用于本地评估场景。",
    "EnableSwagger": false,
    "DisableHttpsRedirect": false
  }
}
