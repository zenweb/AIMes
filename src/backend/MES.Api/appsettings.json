{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Jwt": {
    "Issuer": "AIMes.Dev",
    "Audience": "AIMes.Api",
    "SigningKey": ""
  },
  "ConnectionStrings": {
    "_comment": "DefaultConnection 必须由环境变量提供（ConnectionStrings__DefaultConnection）。docker-compose.yml 已注入 demo 值。",
    "DefaultConnection": "",
    "Redis": "localhost:6379",
    "RabbitMQ": "rabbitmq://localhost"
  },
  "AllowedOrigins": [
    "http://localhost:3000",
    "http://localhost:4200"
  ],
  "AI": {
    "Llm": {
      "Provider": "Ollama",
      "AzureOpenAI": {
        "DeploymentName": "gpt-4-turbo",
        "Endpoint": "https://your-azure-openai-endpoint.openai.azure.com/",
        "ApiKey": "",
        "ApiVersion": "2024-02-15-preview"
      },
      "OpenAI": {
        "ModelId": "gpt-4-turbo",
        "ApiKey": ""
      },
      "Ollama": {
        "BaseUrl": "http://localhost:11434",
        "Model": "llama3.1",
        "ApiKey": null
      }
    },
    "Embedding": {
      "Provider": "AzureOpenAI",
      "DeploymentName": "text-embedding-3-small",
      "Dimensions": 1536
    },
    "VectorStore": {
      "Provider": "InMemory",
      "Qdrant": {
        "Host": "localhost",
        "Port": 6333,
        "ApiKey": null
      }
    },
    "Onnx": {
      "Models": {
        "QualityDefect": {
          "Path": "./models/quality_defect.onnx",
          "Labels": ["OK", "Scratch", "Dent", "Contamination"],
          "InputSize": 224
        },
        "EquipmentAnomaly": {
          "Path": "./models/equipment_anomaly.onnx",
          "Labels": ["Normal", "Warning", "Critical"],
          "InputSize": 100
        }
      }
    },
    "RAG": {
      "ChunkSize": 1000,
      "ChunkOverlap": 200,
      "TopK": 5,
      "SimilarityThreshold": 0.7
    }
  }
}
