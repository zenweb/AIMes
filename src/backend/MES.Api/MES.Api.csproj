<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);1591</NoWarn>
    <!-- 开源构建：dotnet build /p:AimesOpenSource=true 触发 Pro 代码排除（与 MES.AI.csproj 一致） -->
    <DefineConstants Condition="'$(AimesOpenSource)' == 'true'">$(DefineConstants);AIMES_OPEN_SOURCE</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="MES.Tests.Unit" />
  </ItemGroup>

  <!-- 开源构建：排除依赖 Pro 命名空间的端点 -->
  <ItemGroup Condition="'$(AimesOpenSource)' == 'true'">
    <Compile Remove="Endpoints\LlmEndpoints.cs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="AspNetCore.HealthChecks.NpgSql" />
    <PackageReference Include="AspNetCore.HealthChecks.Rabbitmq" />
    <PackageReference Include="AspNetCore.HealthChecks.Redis" />
    <PackageReference Include="MassTransit.RabbitMQ" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" />
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" />
    <PackageReference Include="Microsoft.Extensions.Http.Resilience" />
    <PackageReference Include="Npgsql.OpenTelemetry" />
    <PackageReference Include="OpenTelemetry.Exporter.Console" />
    <PackageReference Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" />
    <PackageReference Include="OpenTelemetry.Extensions.Hosting" />
    <PackageReference Include="OpenTelemetry.Instrumentation.AspNetCore" />
    <PackageReference Include="OpenTelemetry.Instrumentation.EntityFrameworkCore" />
    <PackageReference Include="OpenTelemetry.Instrumentation.Http" />
    <PackageReference Include="OpenTelemetry.Instrumentation.Runtime" />
    <PackageReference Include="Serilog.AspNetCore" />
    <PackageReference Include="Serilog.Enrichers.Environment" />
    <PackageReference Include="Serilog.Settings.Configuration" />
    <PackageReference Include="Serilog.Sinks.Console" />
    <PackageReference Include="Serilog.Sinks.File" />
    <PackageReference Include="Serilog.Sinks.OpenTelemetry" />
    <PackageReference Include="Swashbuckle.AspNetCore" />
    <PackageReference Include="Microsoft.Extensions.Caching.StackExchangeRedis" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\MES.Domain\MES.Domain.csproj" />
    <ProjectReference Include="..\MES.AI\MES.AI.csproj" />
    <ProjectReference Include="..\MES.Application\MES.Application.csproj" />
    <ProjectReference Include="..\MES.Infrastructure\MES.Infrastructure.csproj" />
  </ItemGroup>

  <!-- Validation -->
  <ItemGroup>
    <PackageReference Include="FluentValidation" />
    <PackageReference Include="FluentValidation.AspNetCore" />
  </ItemGroup>

  <!-- 构建后复制前端文件 -->
  <Target Name="CopyFrontendBuild" AfterTargets="AfterBuild" Condition="Exists('../../frontend/.output/public')">
    <ItemGroup>
      <FrontendFiles Include="../../frontend/.output/public/**/*" />
    </ItemGroup>
    <RemoveDir Directories="wwwroot/scheduling" Condition="Exists('wwwroot/scheduling')" />
    <Copy SourceFiles="@(FrontendFiles)" DestinationFolder="wwwroot/scheduling/%(RecursiveDir)" />
  </Target>

  <!-- 发布时也复制 -->
  <Target Name="PublishFrontendBuild" AfterTargets="Publish" Condition="Exists('../../frontend/.output/public')">
    <ItemGroup>
      <FrontendFiles Include="../../frontend/.output/public/**/*" />
    </ItemGroup>
    <Copy SourceFiles="@(FrontendFiles)" DestinationFolder="$(PublishDir)wwwroot/scheduling/%(RecursiveDir)" />
  </Target>
</Project>
